{
  "name": "@getsayall/sayall-mcp",
  "version": "0.1.0",
  "description": "Local-only MCP servers for SayAll apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetSayAll/sayall-mcp.git"
  },
  "homepage": "https://sayall.app",
  "bugs": {
    "url": "https://github.com/GetSayAll/sayall-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sayall",
    "transcription",
    "macos",
    "local-first"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "setup.sh"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "sayall-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "setup": "node dist/cli.js setup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
