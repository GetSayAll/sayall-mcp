{
  "mcpServers": {
    "sayall_history": {
      "command": "/Applications/SayAll.app/Contents/Helpers/SayAllMCP",
      "args": ["serve"],
      "env": {
        "SAYALL_MCP_CLIENT_ID": "<generated-by-sayall-app>",
        "SAYALL_MCP_ACCESS_TOKEN": "<generated-by-sayall-app>"
      }
    }
  }
}
